{
  "schema_version": "1",
  "start_url": "http://127.0.0.1:3000",
  "viewport": {"width": 1440, "height": 900},
  "setup_actions": [
    {
      "kind": "click",
      "target": {"strategy": "role", "role": "button", "name": "Close Welcome Banner"}
    },
    {
      "kind": "click",
      "target": {"strategy": "role", "role": "button", "name": "dismiss cookie message"}
    }
  ],
  "actions": [
    {
      "kind": "click",
      "target": {"strategy": "role", "role": "button", "name": "Open search"}
    },
    {
      "kind": "fill",
      "target": {"strategy": "role", "role": "textbox"},
      "value": "Apple"
    },
    {
      "kind": "press",
      "target": {"strategy": "role", "role": "textbox"},
      "key": "Enter"
    },
    {
      "kind": "click",
      "target": {
        "strategy": "role",
        "role": "button",
        "name": "Add to Basket",
        "scope": {
          "strategy": "role",
          "role": "article",
          "has_text": "Apple Juice (1000ml)"
        }
      }
    }
  ],
  "oracle": {
    "kind": "text",
    "target": {
      "strategy": "role",
      "role": "button",
      "name": "Show the shopping cart"
    },
    "expected_value": "1",
    "match": "contains"
  },
  "source_expected_behavior": "Adding Apple Juice should increase the basket count to 1.",
  "oracle_locked": true
}

